## For Functional Checking

## quick boot
CONFIG_EXT4_FS=y
CONFIG_JBD2=y
CONFIG_VIRTIO_BLK=y

## (ANBZ#6789) Hygon TKM
# CONFIG_IO_STRICT_DEVMEM is not set

## (ANBZ#4924) kvm
CONFIG_KVM=m

## For Performance Checking
CONFIG_SPECULATION_MITIGATIONS=y
CONFIG_HARDENED_USERCOPY=y

## (ANBZ#11914)
CONFIG_RETPOLINE=y

## (ANBZ#10820)
CONFIG_FCOE=m

